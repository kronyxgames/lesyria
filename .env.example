# ═══════════════════════════════════════════════════════════════════════════════
#  Lesyria - variables d'environnement
#
#      cp .env.example .env
#
#  Valeurs de DEVELOPPEMENT : elles ne sont pas secretes et doivent etre
#  changees avant toute mise en production (voir docs/production.md).
#
#  Deux profils compose existent (docker-compose.yml) :
#      dev   : developpement, base et monde dedies, plugin monte depuis target/
#      prod  : production, base et monde persistants
#
#      docker compose --profile dev  up -d
#      docker compose --profile prod up -d
#
#  Le Makefile force le profil : `make up` (dev) et `make up PROFILE=prod`.
# ═══════════════════════════════════════════════════════════════════════════════

# Profil demarre par un simple `docker compose up -d`
COMPOSE_PROFILES=prod

# ─── Identite de l'image ──────────────────────────────────────────────────────
APP_IMAGE_TAG=beta

# ─── Minecraft ────────────────────────────────────────────────────────────────
# EULA=true indique que vous acceptez la licence Minecraft :
# https://aka.ms/MinecraftEULA
EULA=false

# Version Paper epinglee (l'empreinte SHA-256 est verifiee au build)
MC_VERSION=26.2
PAPER_BUILD=123
PAPER_SHA256=7b7b3b43c009103e1971a0576c26f655a7dd9b56a0a2a4438e352c03a7fecd08

# Memoire allouee au serveur (Xms = Xmx)
MEMORY=2G

MOTD=Lesyria - beta
MAX_PLAYERS=100
DIFFICULTY=normal
GAMEMODE=survival
LEVEL_NAME=world
LEVEL_TYPE=minecraft:normal
# Laisser vide pour tirer une graine aleatoire
LEVEL_SEED=
# Zone protegee autour du spawn vanilla (la protection reelle vient du plugin)
SPAWN_PROTECTION=0

# Mode en ligne : true en production (UUID Mojang), false en developpement
ONLINE_MODE=true
ONLINE_MODE_DEV=false

VIEW_DISTANCE=8
SIMULATION_DISTANCE=6
VIEW_DISTANCE_DEV=6
SIMULATION_DISTANCE_DEV=4

# ─── Ports exposes sur l'hote ─────────────────────────────────────────────────
# Production
SERVER_PORT=25565
# Port Bedrock reserve a un futur proxy Geyser (non active en beta)
BEDROCK_PORT=19132
RCON_PORT=25575
API_PORT=8080
# Developpement (ports distincts pour pouvoir faire tourner les deux profils)
SERVER_DEV_PORT=25566
RCON_DEV_PORT=25576
API_DEV_PORT=8081

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=lesyria
POSTGRES_USER=lesyria
POSTGRES_PASSWORD=lesyria-dev-password
# Portrait publie sur 127.0.0.1 uniquement (psql, pg_dump)
POSTGRES_PORT=5432
POSTGRES_DEV_PORT=55432

# URL de connexion. Par defaut, compose calcule l'URL de chaque profil
# (postgres en prod, postgres-dev en dev). Definissez ces variables uniquement
# pour pointer vers une base externe (base managee, serveur dedie).
#DATABASE_URL=postgresql://lesyria:lesyria-dev-password@postgres:5432/lesyria
#DATABASE_URL_DEV=postgresql://lesyria:lesyria-dev-password@postgres-dev:5432/lesyria

# ─── Administration Minecraft (RCON) ─────────────────────────────────────────
# CHANGEZ ce mot de passe en production
RCON_PASSWORD=lesyria-dev-rcon

# ─── API HTTP publique (lecture seule) ────────────────────────────────────────
API_ENABLED=true
# 127.0.0.1 en production (derriere un reverse proxy), 0.0.0.0 en developpement
API_BIND=127.0.0.1
API_BIND_DEV=0.0.0.0
# Origine autorisee pour les appels navigateur (vide = aucun CORS)
API_CORS_ORIGIN=

# ─── Divers ───────────────────────────────────────────────────────────────────
TZ=Europe/Paris
